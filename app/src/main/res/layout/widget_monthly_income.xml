<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_income_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/widget_panel">
    <TextView android:id="@+id/widget_income_month"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#AAB6C0" android:textSize="12sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Начислено" android:textColor="#FFFFFF" android:textSize="15sp"
        android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/widget_income_amount"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B7F34B" android:textStyle="bold" android:textSize="23sp"
        android:maxLines="1"/>
    <ProgressBar android:id="@+id/widget_income_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="7dp" android:max="100" android:progressTint="#B7F34B"/>
    <TextView android:id="@+id/widget_income_goal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#AAB6C0" android:textSize="12sp"
        android:layout_marginTop="4dp" android:maxLines="1"/>
</LinearLayout>
